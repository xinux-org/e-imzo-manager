#: src/ui/about.rs:53
msgid ""
"<p>This release contains following changes</p>\n"
"    <ul>\n"
"        <li>Updated GNOME runtime to 50</li>\n"
"        <li>Display error on dialog when occured</li>\n"
"        <li>Added transition animation with loading spinner</li>\n"
"        <li>Support opening pkcs12 files from file manager: #10</li>\n"
"    </ul>"
msgstr ""
"<ul>\n"
"  <li>GNOME 50 SDK ga yangilandi</li>\n"
"  <li>Xatolik yuz berganda dialog oynasida batafsil koʻrsatish qoʻshildi</"
"li>\n"
"  <li>Kalitlar yuklaniyotganida spinner uchun animatsiya qoʻshildi</li>\n"
"  <li>Pkcs12(.pfx) fayllarini fayl menejeridan ochish qoʻshildi: #10</li>\n"
"</ul>"

